# Copy this file to sensor/.env and fill in at least one key. Never commit sensor/.env.
# Demo mode also works with NO keys: it then replays the AI results stored with the demo photos.

# Free key, about 2 minutes: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional backup, used automatically if Gemini fails: https://build.nvidia.com
NVIDIA_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
